# =========================
# Configuración del backend local
# =========================
# Este proyecto se conecta a un modelo local compatible con OpenAI API.
# Puedes usar LM Studio o Ollama.
#
# Si usas LM Studio:
#   MODEL_BASE_URL=http://host.docker.internal:1234/v1
#   MODEL_API_KEY=lm-studio
#   MODEL_NAME=openai/gpt-oss-20b
#
# Si usas Ollama:
#   MODEL_BASE_URL=http://host.docker.internal:11434/v1
#   MODEL_API_KEY=ollama
#   MODEL_NAME=llama3
#
# Nota:
# MODEL_NAME debe coincidir con el nombre real del modelo cargado
# en tu backend local.

MODEL_BASE_URL=http://host.docker.internal:1234/v1
MODEL_API_KEY=lm-studio
MODEL_NAME=openai/gpt-oss-20b
DATABASE_URL=sqlite:///./data/chat.db